# Virtual Power Plant (VPP) Configuration Template
# Copy this file to .env and fill in your actual values
# WARNING: Never commit .env file with real credentials to version control

# ============================================================================
# Ports exposed to your local machine
# Change these if you have conflicts with other services.
# ============================================================================
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_PORT=9092          # External Kafka port (host access). Internal: kafka:29092
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MLFLOW_PORT=5000
ADMINER_PORT=8080

# ============================================================================
# Database Configuration
# TIMESCALEDB_HOST must match the Docker service name — do not change to localhost.
# Generate a strong password: openssl rand -base64 32
# ============================================================================
TIMESCALEDB_HOST=timescaledb
POSTGRES_DB=postgres
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================================
# MLflow Configuration
# MLFLOW_TRACKING_URI uses the Docker service name (internal).
# MLFLOW_BACKEND_STORE_URI / ARTIFACT_ROOT are paths inside the mlflow container.
# ============================================================================
MLFLOW_BACKEND_STORE_URI=file:///app/mlruns
MLFLOW_DEFAULT_ARTIFACT_ROOT=file:///app/artifacts
MLFLOW_TRACKING_URI=http://mlflow:5000

# ============================================================================
# Python Configuration
# ============================================================================
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ============================================================================
# Kafka Configuration
# KAFKA_BOOTSTRAP_SERVERS must use the internal Docker address (kafka:29092).
# Never set this to localhost — other containers cannot reach localhost.
# KAFKA_ADVERTISED_LISTENERS exposes two listeners:
#   PLAINTEXT       → internal Docker traffic (kafka:29092)
#   PLAINTEXT_HOST  → host machine access (localhost:KAFKA_PORT)
# ============================================================================
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKER_ID=1

# ============================================================================
# Zookeeper Configuration
# ============================================================================
ZOOKEEPER_TICK_TIME=2000

# ============================================================================
# Frontend Configuration
# Must include the /api prefix — the frontend routes all backend calls through it.
# ============================================================================
REACT_APP_API_BASE_URL=http://localhost:8000/api

# ============================================================================
# Application Configuration (Optional)
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, production, testing
ENVIRONMENT=development
